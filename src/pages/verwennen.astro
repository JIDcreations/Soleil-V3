---
import Base from '../layouts/Base.astro';
import Prices from '../components/Prices.astro';
import Book from '../components/Book.astro';
import { services, laser } from '../data/site';
---
<Base title="Ontspanning" description="Arrangementen solo of in de duo-cabine, lichaamsbehandelingen, handen & voeten, epilaties, make-up en laserontharing bij Instituut Soleil in Beervelde." image="/img/duo-cabine.webp">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li><a href="/behandelingen/">Behandelingen</a></li><li aria-current="page">Ontspanning</li></ol>
      <h1>Ontspanning</h1>
      <p class="intro">Van kop tot teen verzorgd worden, alleen of met twee in de duo-cabine.</p>
      <nav class="jump" aria-label="Op deze pagina">
        {services.map((s) => <a href={`#${s.id}`}>{s.name}</a>)}
        <a href="#laser">{laser.name}</a>
      </nav>
    </div>
  </header>
  <section class="section" style="padding-top:clamp(8px,2vw,24px)">
    <div class="wrap">
      {services.map((s) => (
        <article class="treat" id={s.id} style={`scroll-margin-top:calc(var(--header-h) + 8px)`}>
          <figure class="framed ratio-43"><img src={`/img/${s.img}.webp`} alt={s.alt} loading="lazy" /></figure>
          <div>
            <h2>{s.name}</h2>
            <p>{s.text}</p>
            <Prices rows={s.rows} note={s.note} />
            <div class="actions"><Book label="Boek hier" /></div>
          </div>
        </article>
      ))}
      <article class="treat" id="laser" style={`scroll-margin-top:calc(var(--header-h) + 8px)`}>
        <figure class="framed ratio-43"><img src="/img/ontharing.webp" alt="Ontharing" loading="lazy" /></figure>
        <div>
          <h2>{laser.name}</h2>
          <p>{laser.text}</p>
          <div class="actions"><a class="btn" href={laser.url} target="_blank" rel="noopener">{laser.label}</a></div>
        </div>
      </article>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { info, brands } from '../data/site';

const insta = [
  { img: 'instituut-massage', alt: 'De behandelruimte met warm licht en een massagetafel' },
  { img: 'zaakvoerder-behandeling', alt: 'Saskia geeft een rugmassage' },
  { img: 'led-lichttherapie', alt: 'Behandeltafel onder de LED-lamp' },
  { img: 'duo-cabine', alt: 'Twee personen in de duo-cabine' },
  { img: 'zaakvoerder-toestel', alt: 'Saskia naast een behandeltoestel' },
  { img: 'gelaatsverzorging', alt: 'Een gelaatsverzorging in de behandelruimte' },
];
---
<Base title="Over Soleil" description={`Ik ben ${info.owner}, het gezicht achter Instituut Soleil. Al ${info.years} jaar begeleid ik klanten naar een mooiere, sterkere en meer gebalanceerde huid.`} image="/img/zaakvoerder-portret.webp">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li aria-current="page">Over Soleil</li></ol>
    </div>
  </header>

  <section style="padding-bottom:var(--section)">
    <div class="wrap split">
      <figure class="framed sq"><img src="/img/zaakvoerder-portret.webp" alt={`${info.owner}, zaakvoerder van Instituut Soleil`} width="1080" height="1080" fetchpriority="high" /></figure>
      <div>
        <span class="eyebrow">Over Soleil</span>
        <h1>Mijn persoonlijk verhaal</h1>
        <div class="flow muted" style="margin-top:18px">
          <p>Ik ben {info.owner}, het gezicht achter Instituut Soleil. Al {info.years} jaar begeleid ik met veel passie klanten naar een mooiere, sterkere en meer gebalanceerde huid.</p>
          <p>Mijn interesse in duurzame huidverbetering is ook heel persoonlijk gegroeid. Ik heb zelf jarenlang geworsteld met acne en pigmentvlekken en weet hoe frustrerend een probleemhuid kan zijn. Door te werken met doordachte huidverbeterende merken zoals Environ en Jane Iredale kreeg ik mijn eigen huid beter onder controle. Die ervaring motiveerde mij om mij steeds verder te verdiepen en bij te scholen.</p>
          <p>Ik kies bewust voor actieve producten, innovatieve technieken en behandelingen die ondersteund worden door wetenschappelijk onderzoek en kennis. Geen snelle TikTok-trends of loze beloftes, maar eerlijk advies en een aanpak die past bij jouw huid.</p>
          <p>In een stijlvol en rustgevend kader neem ik de tijd om naar jou en je huid te luisteren. Samen werken we stap voor stap aan een huid die gezonder, egaler, sterker en meer in balans aanvoelt.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bronze" aria-labelledby="sta">
    <div class="wrap">
      <h2 id="sta" style="margin-bottom:clamp(24px,3vw,36px)">Waar ik voor sta</h2>
      <div class="beliefs">
        <div><h3>Geen quick fix</h3><p>Elke huid is anders. Ik maak graag extra tijd vrij om je persoonlijk te adviseren en te begeleiden.</p></div>
        <div><h3>Thuis telt</h3><p>Wonderen met enkel professionele behandelingen bestaan niet. 75% van het resultaat komt van je verzorging thuis.</p></div>
        <div><h3>Bewezen werking</h3><p>Ik werk uitsluitend met producten en technieken die wetenschappelijk onderbouwd zijn.</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="merken">
    <div class="wrap">
      <div class="head center">
        <h2 id="merken" class="rule">Merken waar ik mee werk</h2>
      </div>
      <ul class="tiles" role="list">
        {brands.map((b) => (
          <li class="tile fade">
            <figure class="sq">{b.img ? <img src={`/img/${b.img}.webp`} alt={`Producten van ${b.name}`} loading="lazy" /> : <span class="tile-word" aria-hidden="true">{b.name}</span>}</figure>
            <div><h3>{b.name}</h3><p>{b.line}</p></div>
          </li>
        ))}
      </ul>
      <p class="center" style="margin-top:36px"><a class="btn btn--line" href={info.webshop} target="_blank" rel="noopener">Naar de webshop</a></p>
    </div>
  </section>

  <section class="section beige" aria-labelledby="inst">
    <div class="wrap">
      <div class="head center">
        <h2 id="inst" class="rule">Het instituut</h2>
        <p>Een stijlvol en warm kader waar verzorging en ontspanning samenkomen.</p>
      </div>
      <ul class="ig" role="list">
        {insta.map((i) => <li class="sq fade"><img src={`/img/${i.img}.webp`} alt={i.alt} loading="lazy" /></li>)}
      </ul>
      <p class="center" style="margin-top:28px"><a class="link" href={info.instagram} target="_blank" rel="noopener">Volg Soleil op Instagram</a></p>
    </div>
  </section>
</Base>

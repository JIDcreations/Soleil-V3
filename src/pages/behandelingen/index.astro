---
import Base from '../../layouts/Base.astro';
import { groups, href, euro } from '../../data/site';
---
<Base title="Behandelingen" description="Skin Discovery, huidanalyse, Skin Relax, Skin Expert en ontspanning bij Instituut Soleil in Beervelde.">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li aria-current="page">Behandelingen</li></ol>
      <h1>Behandelingen</h1>
      <p class="intro">Nieuw bij Soleil? Begin met een <a class="link" href="/behandelingen/skin-discovery/">Skin Discovery</a>.</p>
    </div>
  </header>
  <section class="section" style="padding-top:0">
    <div class="wrap split split--even" style="align-items:start">
      {groups.map((g) => (
        <div id={g.title.toLowerCase()} style="scroll-margin-top:calc(var(--header-h) + 16px)">
          <h2 class="eyebrow" style="font-size:0.78rem">{g.title}</h2>
          <ul class="list" role="list">
            {g.items.map((t) => (
              <li>
                <a href={href(t)}>
                  <span class="sq"><img src={`/img/${t.img}.webp`} alt="" loading="lazy" /></span>
                  <span><strong>{t.name}</strong><span class="d">{t.sub}</span></span>
                  <span class="p">{t.from > 0 ? euro(t.from) : 'meer info'}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import Prices from '../../components/Prices.astro';
import Book from '../../components/Book.astro';
import { skin, euro } from '../../data/site';

export function getStaticPaths() {
  return skin.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const others = skin.filter((s) => s.slug !== t.slug);
---
<Base title={t.name} description={`${t.name} bij Instituut Soleil in Beervelde: ${t.sub}. Vanaf ${euro(t.from)}.`} image={`/img/${t.img}.webp`}>
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li><a href="/behandelingen/">Behandelingen</a></li><li aria-current="page">{t.name}</li></ol>
    </div>
  </header>

  {t.parts ? (
    <>
      <section style="padding-bottom:clamp(32px,4vw,48px)">
        <div class="wrap split">
          <figure class="framed ratio-43"><img src={`/img/${t.img}.webp`} alt={t.alt} fetchpriority="high" /></figure>
          <div>
            <span class="eyebrow">{t.sub}</span>
            <h1>{t.name}</h1>
            <p class="muted" style="margin-top:14px">{t.intro}</p>
            <p class="small" style="margin-top:14px">Vanaf {euro(t.from)} · {t.parts.map((p, i) => <>{i > 0 && ' · '}<a class="link" href={`#${p.id}`}>{p.name}</a></>)}</p>
            {t.tip && <p class="tip">{t.tip} <a class="link" href="/behandelingen/huidanalyse/#prijzen">Meer over de Skin Discovery</a></p>}
          </div>
        </div>
      </section>
      <section class="section beige" id="prijzen">
        <div class="wrap">
          {t.parts.map((p) => (
            <article class="treat" id={p.id}>
              <figure class="ratio-43"><img src={`/img/${p.img}.webp`} alt={p.alt} loading="lazy" /></figure>
              <div>
                <h2>{p.name}</h2>
                <p class="sub">vanaf {euro(Math.min(...p.prices.flatMap((g) => g.rows).map((r) => (typeof r[2] === 'number' ? r[2] : 999))))}</p>
                <p>{p.text}</p>
                {p.prices.map((g) => <Prices rows={g.rows} title={g.title} note={g.note} />)}
                <div class="actions"><Book label="Boek hier" /></div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </>
  ) : (
    <section style="padding-bottom:var(--section)">
      <div class="wrap split">
        <figure class="framed ratio-43"><img src={`/img/${t.img}.webp`} alt={t.alt} fetchpriority="high" /></figure>
        <div id="prijzen">
          <span class="eyebrow">{t.sub}</span>
          <h1>{t.name}</h1>
          <p class="muted" style="margin:14px 0 24px">{t.intro}</p>
          {t.prices.map((g) => <Prices rows={g.rows} title={g.title} note={g.note} />)}
          {t.tip && <p class="tip">{t.tip}</p>}
          <div class="actions"><Book label="Boek hier" /></div>
        </div>
      </div>
    </section>
  )}

  <section class="section--tight">
    <div class="wrap">
      <p class="small muted">Andere behandelingen: {others.map((o, i) => <>{i > 0 && ' · '}<a class="link" href={`/behandelingen/${o.slug}/`}>{o.name}</a></>)} · <a class="link" href="/verwennen/">Ontspanning</a> · <a class="link" href="/tarieven/">Alle tarieven</a></p>
    </div>
  </section>
</Base>

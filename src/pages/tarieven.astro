---
import Base from '../layouts/Base.astro';
import Prices from '../components/Prices.astro';
import Book from '../components/Book.astro';
import { treatments, href } from '../data/site';

// Skin Discovery is already listed under Huidanalyse and Skin Relax.
const list = treatments.filter((t) => t.slug !== 'skin-discovery');
---
<Base title="Tarieven" description="Alle prijzen van Instituut Soleil in Beervelde: huidanalyse, Skin Relax, Skin Expert, arrangementen, lichaam, handen & voeten, epilaties en make-up.">
  <header class="page-head">
    <div class="wrap--narrow center">
      <ol class="crumbs" role="list" style="justify-content:center"><li><a href="/">Home</a></li><li aria-current="page">Tarieven</li></ol>
      <h1 class="rule">Tarieven</h1>
      <p class="intro" style="margin-inline:auto">Weet je niet goed wat kiezen en wil je aan huidverbetering werken? Boek dan best een <a class="link" href="/behandelingen/skin-discovery/">Skin Discovery</a>.</p>
      <nav class="jump" aria-label="Categorieën" style="justify-content:center">
        {list.map((t) => <a href={`#${t.slug}`}>{t.name}</a>)}
      </nav>
    </div>
  </header>

  <section class="section" style="padding-top:8px">
    <div class="wrap--narrow">
      {list.map((t) => (
        <section class="tarief" id={t.slug} aria-labelledby={`h-${t.slug}`}>
          <div class="tarief-head"><h2 id={`h-${t.slug}`}>{t.name} <span class="muted small">· {t.sub}</span></h2><a class="link" href={href(t)}>Meer info</a></div>
          {(t.slug === 'skin-expert' || t.link) && <p>{t.intro}</p>}
          {t.prices.map((g) => <Prices rows={g.rows} title={g.title} note={g.note} />)}
          {t.parts?.map((p) => <Prices rows={p.prices.flatMap((g) => g.rows)} title={p.name} />)}
          {t.note && <p class="price-note">{t.note}</p>}
          {t.link && <p><a class="link" href={t.link.href} target="_blank" rel="noopener">{t.link.label}</a></p>}
        </section>
      ))}
      <div class="block center" style="margin-top:32px">
        <p class="h3">Klaar om te boeken?</p>
        <div class="actions" style="justify-content:center;margin-top:14px"><Book /></div>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import journal from '../../data/journal.json';
---
<Base title="Journaal" description="Huidtips per seizoen en nieuws uit Instituut Soleil in Beervelde.">
  <header class="wrap ph-head">
    <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li aria-current="page">Journaal</li></ol>
    <h1 class="h1">Journaal</h1>
    <p class="lede">Huidtips per seizoen en nieuws uit het instituut.</p>
  </header>
  <section class="wrap posts" style="padding-bottom:var(--section)">{journal.map((p) => <PostCard post={p} />)}</section>
</Base>

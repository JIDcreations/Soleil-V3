---
import Base from '../../layouts/Base.astro';
import Week from '../../components/Week.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import journal from '../../data/journal.json';
import { info } from '../../data/site';

export function getStaticPaths() {
  return journal.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const date = new Intl.DateTimeFormat('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(p.date));
// group consecutive list items
type B = { type: string; text: string };
const blocks: (B | { type: 'ul'; items: string[] })[] = [];
for (const b of p.blocks as B[]) {
  const last = blocks[blocks.length - 1] as any;
  if (b.type === 'li') { if (last?.type === 'ul') last.items.push(b.text); else blocks.push({ type: 'ul', items: [b.text] }); }
  else blocks.push(b);
}
const more = journal.filter((x) => x.slug !== p.slug).slice(0, 3);
---
<Base title={p.title} description={p.excerpt.slice(0, 155)} image={`/img/${p.img}.webp`}>
  <article class="wrap article">
    <header class="ph-head">
      <ol class="crumbs" role="list"><li><a href="/">Home</a></li><li><a href="/journaal/">Journaal</a></li><li aria-current="page">{p.cat}</li></ol>
      <p class="post-meta" style="margin-top:24px"><span class="label">{p.cat}</span><time datetime={p.date}>{date}</time></p>
      <h1 class="h1">{p.title}</h1>
    </header>
    <figure class="ph article-hero"><img src={`/img/${p.img}.webp`} alt="" fetchpriority="high" /></figure>
    <div class="prose">
      {blocks.map((b: any) =>
        b.type === 'h2' ? <h2 class="h3">{b.text}</h2> :
        b.type === 'ul' ? <ul role="list">{b.items.map((i: string) => <li>{i}</li>)}</ul> :
        b.type === 'hours' ? <div style="margin-block:1.6em"><Week /></div> :
        <p>{b.text}</p>
      )}
      <div class="actions" style="margin-top:56px">
        <a class="btn" href={info.booking} target="_blank" rel="noopener">Afspraak maken<Icon name="arrow-up-right" /></a>
        <a class="link" href="/behandelingen/skin-discovery/">Nieuw? Start met een Skin Discovery<Icon name="arrow-right" /></a>
      </div>
    </div>
  </article>
  <section class="section wrap" aria-labelledby="meer">
    <div class="sec-head"><h2 id="meer" class="h2">Meer uit het journaal</h2><a class="link" href="/journaal/">Alle artikels<Icon name="arrow-right" /></a></div>
    <div class="posts">{more.map((m) => <PostCard post={m} />)}</div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import Book from '../components/Book.astro';
import Icon from '../components/Icon.astro';
import { info, skin, relax, brands, usps, reviews, reviewsArePlaceholders, href, euro } from '../data/site';

const tiles = [
  ...skin.filter((s) => s.slug !== 'skin-discovery').map((s) => ({ href: href(s), name: s.name, sub: s.sub, img: s.img, alt: s.alt, from: s.from })),
  { href: '/behandelingen/#ontspanning', name: 'Ontspanning', sub: 'arrangementen, lichaam, handen & voeten', img: 'massage-lichaam', alt: 'Rugmassage', from: Math.min(...relax.filter((r) => r.from > 0).map((r) => r.from)) },
];
---
<Base
  title="Instituut Soleil | Huidverbetering in Beervelde"
  description="Instituut Soleil in Beervelde: huidanalyse, Skin Relax en Skin Expert gelaatsverzorgingen, ontspanning en eerlijk persoonlijk advies."
>
  <link slot="head" rel="preload" as="image" href="/img/zaakvoerder-behandeling.webp" fetchpriority="high" />

  <section class="hero" aria-labelledby="h1">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <span class="eyebrow">Instituut Soleil · Beervelde</span>
        <h1 id="h1">Stralen begint bij een huid in balans.</h1>
        <p>Huidverbetering met eerlijk, persoonlijk advies. Al {info.years} jaar in Beervelde.</p>
        <div class="actions">
          <Book />
          <a class="link" href="/behandelingen/skin-discovery/">Nieuw? Begin met een Discovery-behandeling</a>
        </div>
      </div>
      <figure class="hero-media"><img src="/img/zaakvoerder-behandeling.webp" alt="Saskia geeft een rugmassage in haar behandelruimte" width="1600" height="1135" fetchpriority="high" /></figure>
    </div>
  </section>

  <section class="section" aria-labelledby="welkom">
    <div class="wrap welcome">
      <figure class="framed framed--left sq fade"><img src="/img/zaakvoerder-portret.webp" alt={`${info.owner}, zaakvoerder van Instituut Soleil`} width="1080" height="1080" loading="lazy" /></figure>
      <div class="fade">
        <span class="eyebrow">Welkom bij Soleil</span>
        <h2 id="welkom">Ik ben {info.owner}</h2>
        <p class="muted" style="margin-top:14px">Al {info.years} jaar begeleid ik klanten naar een gezondere, sterkere huid. In een stijlvol en rustgevend kader neem ik de tijd om naar jou en je huid te luisteren, met producten en technieken die hun werking bewezen hebben.</p>
        <p style="margin-top:20px"><a class="link" href="/over-soleil/">Lees mijn verhaal</a></p>
      </div>
    </div>
  </section>

  <section class="section beige" aria-labelledby="usp">
    <div class="wrap">
      <div class="head center">
        <h2 id="usp" class="rule">Waarom Soleil</h2>
      </div>
      <ul class="usps" role="list">
        {usps.map((u) => (
          <li class="usp fade">
            <span class="usp-icon"><Icon name={u.icon} /></span>
            <h3>{u.title}</h3>
            <p>{u.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="reviews">
    <div class="wrap">
      <div class="head center">
        <h2 id="reviews" class="rule">Wat klanten zeggen</h2>
        {reviewsArePlaceholders && <p class="small">Voorbeeldreviews: deze vervangen we door echte reviews van klanten.</p>}
      </div>
      <ul class="reviews" role="list">
        {reviews.map((r) => (
          <li class="fade">
            <blockquote>“{r.text}”</blockquote>
            <p><strong>{r.name}</strong><span>{r.place}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="beh">
    <div class="wrap">
      <div class="head center">
        <h2 id="beh" class="rule">Behandelingen</h2>
      </div>
      <ul class="tiles" role="list">
        {tiles.map((t) => (
          <li class="fade">
            <a class="tile" href={t.href}>
              <figure class="sq"><img src={`/img/${t.img}.webp`} alt={t.alt} loading="lazy" /></figure>
              <div>
                <h3>{t.name}</h3>
                <p>{t.sub}</p>
                <p class="from">vanaf {euro(t.from)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="center" style="margin-top:36px"><a class="link" href="/tarieven/">Alle tarieven</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="disc">
    <div class="wrap offer">
      <figure class="framed ratio-45 fade"><img src="/img/zaakvoerder-toestel.webp" alt="Saskia naast een behandeltoestel in het instituut" loading="lazy" /></figure>
      <div class="fade">
        <span class="eyebrow">Nieuw bij Soleil?</span>
        <h2 id="disc">Begin met een Skin Discovery</h2>
        <p class="offer-price"><strong>€105</strong><span class="muted">90 minuten</span></p>
        <p class="muted" style="margin-top:14px">Leer jouw huid beter kennen. We combineren een huidanalyse met een aangepaste gelaatsverzorging en persoonlijk advies voor thuis. Ideaal als eerste behandeling.</p>
        <div class="actions"><Book label="Boek een Skin Discovery" /><a class="link" href="/behandelingen/skin-discovery/">Meer over de Skin Discovery</a></div>
      </div>
    </div>
  </section>

  <section class="section beige" aria-labelledby="merken">
    <div class="wrap">
      <div class="head center">
        <h2 id="merken" class="rule">Merken waar ik op vertrouw</h2>
        <p>Merken met veel actieve bestanddelen, jarenlang onderzoek en klinische testen.</p>
      </div>
      <ul class="tiles" role="list">
        {brands.map((b) => (
          <li class="tile fade">
            <figure class="sq">{b.img ? <img src={`/img/${b.img}.webp`} alt={`Producten van ${b.name}`} loading="lazy" /> : <span class="tile-word" aria-hidden="true">{b.name}</span>}</figure>
            <div><h3>{b.name}</h3><p>{b.line}</p></div>
          </li>
        ))}
      </ul>
      <p class="center" style="margin-top:36px"><a class="link" href={info.webshop} target="_blank" rel="noopener">Naar de webshop</a></p>
    </div>
  </section>
</Base>

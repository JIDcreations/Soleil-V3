---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { info, brands, skin, relax, usps, reviews, reviewsArePlaceholders, euro } from '../data/site';

const t = (slug: string) => [...skin, ...relax].find((x) => x.slug === slug)!;
const cards = [
  { ...t('huidanalyse'), href: '/behandelingen/huidanalyse/' },
  { ...t('skin-relax'), href: '/behandelingen/skin-relax/' },
  { ...t('skin-expert'), href: '/behandelingen/skin-expert/' },
  { ...t('arrangementen'), name: 'Ontspanning', sub: 'arrangementen, lichaam, handen & voeten', img: 'massage-lichaam', href: '/behandelingen/#ontspanning' },
];
const icons = ['medal', 'scan', 'chat-circle', 'house-line'];
---
<Base title="Instituut Soleil | Huidverbetering in Beervelde" description="Instituut Soleil in Beervelde: huidanalyse, Skin Relax en Skin Expert, ontspanning en eerlijk persoonlijk advies.">
  <link slot="head" rel="preload" as="image" href="/img/zaakvoerder-behandeling.webp" fetchpriority="high" />

  <section class="hero" aria-labelledby="h1">
    <div class="wrap">
      <div class="hero-frame">
        <img src="/img/zaakvoerder-behandeling.webp" alt="Saskia geeft een behandeling in haar instituut" width="1600" height="1135" fetchpriority="high" />
        <div class="hero-copy">
          <h1 id="h1" class="display rv">Stralen begint bij een huid <em>in balans.</em></h1>
          <p class="lede rv" style="--d:1">Huidverbetering met bewezen technieken en eerlijk, persoonlijk advies. Al {info.years} jaar in Beervelde.</p>
          <div class="actions rv" style="--d:2">
            <a class="btn btn--light" href={info.booking} target="_blank" rel="noopener">Afspraak maken<Icon name="arrow-up-right" /></a>
            <a class="link" href="/behandelingen/skin-discovery/">Start met een Skin Discovery<Icon name="arrow-right" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="Waarom Soleil">
    <div class="wrap">
      <ul class="usp" role="list">
        {usps.map((u, i) => (
          <li class="rv" style={`--d:${i}`}><Icon name={icons[i]} /><h3>{u.title}</h3><p>{u.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="beh">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="beh" class="h1 rv">Behandelingen</h2>
        <a class="link rv" href="/tarieven/">Alle tarieven<Icon name="arrow-right" /></a>
      </div>
      <a class="disc rv" href="/behandelingen/skin-discovery/">
        <div>
          <p class="label">Nieuw bij Soleil?</p>
          <h3>Begin met een Skin Discovery</h3>
          <p class="t">Een huidanalyse, een verzorging op maat en persoonlijk advies voor thuis. Ideaal als eerste behandeling.</p>
        </div>
        <div class="disc-side">
          <p><strong>{euro(105)}</strong><small>90 minuten</small></p>
          <span class="btn btn--light">Bekijk<Icon name="arrow-right" /></span>
        </div>
      </a>
      <ul class="cards" role="list">
        {cards.map((c, i) => (
          <li class="rv" style={`--d:${i}`}>
            <a href={c.href}>
              <figure class="ph"><img src={`/img/${c.img}.webp`} alt="" loading="lazy" /></figure>
              <h3>{c.name}<Icon name="arrow-up-right" /></h3>
              <p>{c.sub}</p>
              <p class="price">{euro(c.from)}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-label="Over Saskia">
    <div class="wrap manifesto">
      <figure class="ph rv-img"><img src="/img/zaakvoerder-portret.webp" alt={`${info.owner}, zaakvoerder van Instituut Soleil`} loading="lazy" /></figure>
      <div>
        <blockquote class="rv">Geen snelle trends of loze beloftes. Ik neem de tijd om naar jou en je huid te luisteren, en werk stap voor stap aan een huid die <em>gezonder en sterker</em> aanvoelt.</blockquote>
        <footer class="rv" style="--d:1">
          <span>{info.owner}, zaakvoerder</span>
          <a class="link" href="/over-soleil/">Mijn verhaal<Icon name="arrow-right" /></a>
        </footer>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="reviews">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 id="reviews" class="h1 rv">Wat klanten zeggen</h2>
          {reviewsArePlaceholders && <p class="muted rv">Voorbeeldreviews: deze vervangen we door echte reviews van klanten.</p>}
        </div>
      </div>
      <ul class="quotes" role="list">
        {reviews.map((r, i) => (
          <li class="rv" style={`--d:${i}`}>
            <blockquote>“{r.text}”</blockquote>
            <p><strong>{r.name}</strong><span>{r.place}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="merken">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 id="merken" class="h1 rv">Merken waar ik op vertrouw</h2>
          <p class="muted rv">Merken met veel actieve bestanddelen, jarenlang onderzoek en klinische testen.</p>
        </div>
        <a class="link rv" href={info.webshop} target="_blank" rel="noopener">Naar de webshop<Icon name="arrow-up-right" /></a>
      </div>
      <ul class="btiles" role="list">
        {brands.map((b, i) => (
          <li class="rv" style={`--d:${i}`}>
            <figure class="ph">{b.img ? <img src={`/img/${b.img}.webp`} alt={`Producten van ${b.name}`} loading="lazy" /> : <span class="word" aria-hidden="true">{b.name}</span>}</figure>
            <h3>{b.name}</h3>
            <p>{b.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" style="padding-bottom:0" aria-labelledby="cta">
    <div class="wrap">
      <div class="band rv-img">
        <img src="/img/instituut-massage.webp" alt="" loading="lazy" />
        <div>
          <h2 id="cta" class="h1">Even helemaal tijd voor jezelf.</h2>
          <div class="actions"><a class="btn btn--light" href="/behandelingen/arrangementen/">Bekijk de arrangementen<Icon name="arrow-right" /></a></div>
        </div>
      </div>
    </div>
  </section>
</Base>

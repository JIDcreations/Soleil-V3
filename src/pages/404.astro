---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer).">
  <header class="page-head page-head--plain" style="min-height:70dvh">
    <div class="wrap page-head-in">
      <div>
        <h1 class="display">Deze pagina bestaat niet (meer).</h1>
        <p class="lede">Misschien is ze verhuisd. Begin opnieuw bij de behandelingen of ga terug naar de homepagina.</p>
        <div class="actions"><a class="btn" href="/behandelingen/">Naar de behandelingen</a><a class="link" href="/">Naar de homepagina</a></div>
      </div>
    </div>
  </header>
</Base>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer).">
  <header class="wrap ph-head" style="min-height:50dvh">
    <h1 class="h1">Deze pagina bestaat niet (meer).</h1>
    <p class="lede">Misschien is ze verhuisd. Bekijk de behandelingen of ga terug naar de homepagina.</p>
    <div class="actions" style="margin-top:32px"><a class="btn" href="/behandelingen/">Naar de behandelingen<Icon name="arrow-right" /></a><a class="link" href="/">Naar de homepagina</a></div>
  </header>
</Base>

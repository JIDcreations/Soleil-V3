---
/* The Soleil mark, redrawn as vector from the price list / Instagram logo.
   draw: strokes reveal themselves once (used in the hero only). */
import logo from '../assets/logo-data.json';
interface Props { class?: string; draw?: boolean; label?: string }
const { class: cls = '', draw = false, label } = Astro.props;
const id = `lm${Math.random().toString(36).slice(2, 7)}`;
---
<svg
  class:list={['logo-mark', cls, { 'logo-draw': draw }]}
  viewBox={logo.viewBox}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {draw ? (
    <>
      <defs>
        <mask id={id} maskUnits="userSpaceOnUse">
          {logo.lines.map((d, i) => (
            <path d={d} pathLength="1" fill="none" stroke="#fff" stroke-width={i === 0 ? 46 : 34} stroke-linecap="round" style={`--i:${i}`} />
          ))}
        </mask>
      </defs>
      <g mask={`url(#${id})`}>{logo.paths.map((d) => <path d={d} />)}</g>
    </>
  ) : (
    logo.paths.map((d) => <path d={d} />)
  )}
</svg>

<style is:global>
  .logo-draw mask path { stroke-dasharray: 1 1; stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .js .logo-draw mask path { stroke-dashoffset: 1; }
    .js.is-loaded .logo-draw mask path {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.6s cubic-bezier(0.65, 0, 0.35, 1);
      transition-delay: calc(0.1s + var(--i) * 0.28s);
    }
  }
</style>

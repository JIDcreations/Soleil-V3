---
/* Phosphor icons, light weight, read from @phosphor-icons/core at build time. */
const icons = import.meta.glob('/node_modules/@phosphor-icons/core/assets/light/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { name: string; class?: string }
const { name, class: cls = '' } = Astro.props;
const raw = icons[`/node_modules/@phosphor-icons/core/assets/light/${name}-light.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw.replace('<svg', `<svg class="${cls}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />

---
/* Temporary A/B switch while the client compares both designs. Remove before go-live.
   Links to the same page in the other version when it exists there. */
const path = Astro.url.pathname;
const isB = path === '/v2/' || path.startsWith('/v2/');
const inB = (p: string) => p === '/' || /^\/(behandelingen|tarieven|over-soleil|contact)\//.test(p);
const a = isB ? path.replace(/^\/v2/, '') || '/' : path;
const b = isB ? path : inB(path) ? `/v2${path}` : '/v2/';
---
<nav class="vswitch" aria-label="Ontwerpversie">
  <span>Ontwerp</span>
  <a href={a} aria-current={!isB ? 'true' : undefined}>Versie A</a>
  <a href={b} aria-current={isB ? 'true' : undefined}>Versie B</a>
</nav>

---
/* Version B header: logo left, all pages visible right, Behandelingen opens a wide panel.
   On phones the same content lives in a full-screen menu. */
import Logo from '../Logo.astro';
import Icon from '../Icon.astro';
import { info, groups, euro } from '../../data/site';
const path = Astro.url.pathname;
const href = (slug: string) => `/v2/behandelingen/${slug}/`;
const cur = (h: string) => (path === h ? 'page' : undefined);
const pages = [
  { href: '/v2/', label: 'Home' },
  { href: '/v2/behandelingen/', label: 'Alle behandelingen' },
  { href: '/v2/tarieven/', label: 'Tarieven' },
  { href: '/v2/over-soleil/', label: 'Over Soleil' },
  { href: '/v2/contact/', label: 'Contact' },
];
---
<a class="skip" href="#main">Naar de inhoud</a>
<header class="hd" data-header>
  <div class="wrap hd-main">
    <a class="brand" href="/v2/" aria-label="Instituut Soleil, naar de homepagina">
      <Logo />
      <span class="brand-word" aria-hidden="true"><small>instituut</small><span>SOLEIL</span></span>
    </a>
    <nav class="nv" aria-label="Hoofdmenu">
      <button class="nv-item" type="button" aria-expanded="false" aria-controls="v2-mega" data-dd-btn data-current={path.startsWith('/v2/behandelingen/') ? 'true' : undefined}>Behandelingen<Icon name="caret-down" /></button>
      <a class="nv-item" href="/v2/tarieven/" aria-current={cur('/v2/tarieven/')}>Tarieven</a>
      <a class="nv-item" href="/v2/over-soleil/" aria-current={cur('/v2/over-soleil/')}>Over Soleil</a>
      <a class="nv-item" href="/v2/contact/" aria-current={cur('/v2/contact/')}>Contact</a>
      <a class="btn hd-book" href={info.booking} target="_blank" rel="noopener">Afspraak maken</a>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="v2-menu" data-menu-btn>
      <span data-menu-label>Menu</span><i aria-hidden="true"></i>
    </button>
  </div>
  <div class="mega" id="v2-mega" data-mega>
    <div class="wrap mega-in">
      {groups.map((g) => (
        <div>
          <p class="label">{g.title}</p>
          <ul role="list">
            {g.items.map((t) => <li><a href={href(t.slug)} aria-current={cur(href(t.slug))}><span>{t.name}</span>{t.from > 0 && <small>{euro(t.from)}</small>}</a></li>)}
          </ul>
        </div>
      ))}
      <a class="menu-card" href="/v2/behandelingen/skin-discovery/">
        <img src="/img/zaakvoerder-toestel.webp" alt="" loading="lazy" />
        <span><small>Nieuw bij Soleil?</small>Start met een Skin Discovery</span>
      </a>
    </div>
  </div>
</header>
<div class="menu" id="v2-menu" data-sheet>
  <div class="wrap menu-in">
    <nav class="menu-treat" aria-label="Behandelingen">
      {groups.map((g) => (
        <div>
          <p class="label">{g.title}</p>
          <ul role="list">
            {g.items.map((t) => (
              <li><a href={href(t.slug)} aria-current={cur(href(t.slug))}><span>{t.name}</span>{t.from > 0 && <small>{euro(t.from)}</small>}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <div class="menu-side">
      <nav aria-label="Pagina's">
        <ul role="list">{pages.map((p) => <li><a href={p.href} aria-current={cur(p.href)}>{p.label}</a></li>)}</ul>
      </nav>
      <a class="menu-card" href="/v2/behandelingen/skin-discovery/">
        <img src="/img/zaakvoerder-toestel.webp" alt="" loading="lazy" />
        <span><small>Nieuw bij Soleil?</small>Start met een Skin Discovery</span>
      </a>
      <p class="menu-contact">
        <a href={info.phoneHref}><Icon name="phone" />{info.phone}</a>
        <a href={info.route} target="_blank" rel="noopener"><Icon name="map-pin" />{info.street}, Beervelde</a>
      </p>
    </div>
  </div>
</div>
<a class="dock btn" href={info.booking} target="_blank" rel="noopener" data-dock>Afspraak maken</a>

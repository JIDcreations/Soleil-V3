---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import Book from './Book.astro';
import { info, skinMenu, relaxMenu, euro } from '../data/site';
const path = Astro.url.pathname;
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
const inTreatments = path.startsWith('/behandelingen/') || path.startsWith('/verwennen/');
const main = [
  { href: '/tarieven/', label: 'Tarieven' },
  { href: '/over-soleil/', label: 'Over Soleil' },
  { href: '/contact/', label: 'Contact' },
];
---
<a class="skip" href="#main">Naar de inhoud</a>
<header class="header" data-header>
  <div class="wrap header-in">
    <Brand />
    <nav class="nav" aria-label="Hoofdmenu">
      <div class="dd" data-dd>
        <button class="dd-btn" type="button" aria-expanded="false" aria-controls="dd-beh" data-current={inTreatments ? 'true' : undefined}>
          Behandelingen<Icon name="caret-down" />
        </button>
        <div class="dd-panel" id="dd-beh">
          <div>
            <p class="dd-title">Huidverbetering</p>
            <ul role="list">
              {skinMenu.map((o) => <li><a href={o.href} aria-current={current(o.href)}><span>{o.label}</span><small>vanaf {euro(o.from)}</small></a></li>)}
            </ul>
          </div>
          <div>
            <p class="dd-title">Ontspanning</p>
            <ul role="list">
              {relaxMenu.map((o) => <li><a href={o.href}><span>{o.label}</span>{o.from && <small>vanaf {euro(o.from)}</small>}</a></li>)}
            </ul>
          </div>
          <div class="dd-foot">
            <a class="link" href="/behandelingen/">Alle behandelingen</a>
            <a class="link" href="/behandelingen/huidanalyse/#prijzen">Nieuw? Begin met een Discovery-behandeling</a>
          </div>
        </div>
      </div>
      {main.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
      <Book />
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="sheet" data-menu-btn>
      <span data-menu-label>Menu</span><i aria-hidden="true"></i>
    </button>
  </div>
</header>
<div class="sheet" id="sheet" data-sheet>
  <nav aria-label="Menu">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
    <a href="/behandelingen/" aria-current={path === '/behandelingen/' ? 'page' : undefined}>Behandelingen</a>
    {skinMenu.map((o) => <a class="sub" href={o.href} aria-current={current(o.href)}>{o.label}</a>)}
    <a class="sub" href="/verwennen/" aria-current={current('/verwennen/')}>Ontspanning</a>
    {main.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
  </nav>
  <div class="sheet-foot">
    <Book />
    <a class="btn btn--line" href={info.phoneHref}><Icon name="phone" />{info.phone}</a>
  </div>
</div>
<div class="dock" data-dock>
  <Book />
  <a class="call" href={info.phoneHref} aria-label={`Bel ${info.phone}`}><Icon name="phone" /></a>
</div>

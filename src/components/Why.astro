---
/* Problem → solution → benefit, per treatment, as a small FAQ that opens and closes. */
import Icon from './Icon.astro';
interface Props { why: { problem: string; solution: string; benefit: string } }
const { why } = Astro.props;
const items = [
  { icon: 'question', title: 'Herken je dit?', text: why.problem },
  { icon: 'hand-heart', title: 'Wat ik doe', text: why.solution },
  { icon: 'sparkle', title: 'Wat jij eraan hebt', text: why.benefit },
];
---
<section class="faq" aria-label="Goed om te weten">
  {items.map((it) => (
    <details>
      <summary>
        <span class="faq-icon"><Icon name={it.icon} /></span>
        <span class="faq-q">{it.title}</span>
        <span class="faq-toggle" aria-hidden="true"><Icon name="plus" /></span>
      </summary>
      <p>{it.text}</p>
    </details>
  ))}
</section>
